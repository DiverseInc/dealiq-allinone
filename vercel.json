{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/landing.html" },
    { "source": "/app", "destination": "/broker.html" },
    { "source": "/index.html", "destination": "/landing.html" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/([^/]+)/?$", "destination": "/.html" }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
